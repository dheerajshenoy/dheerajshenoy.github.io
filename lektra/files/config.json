    {
        "name": "Picker.Keys",
        "fields": [],
        "section_desc": "<p>Picker keyboard binding options struct.</p> <p> Valid actions are:</p> <ul> <li><code class=\"inline\">up</code></li> <li><code class=\"inline\">down</code></li> <li><code class=\"inline\">select</code></li> <li><code class=\"inline\">dismiss</code></li> </ul> <p>Example:</p> <pre><code class=\"language-toml\">[picker.keys]<br>\n# Format: command_name = \"KeyCombination\"\n# Single key\nup = \"Up\"\n# Multiple keys\ndown = [\"j\", \"Down\"] # Added in 0.6.9\n</code></pre>",
